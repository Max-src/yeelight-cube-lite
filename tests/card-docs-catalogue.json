{
    "clock": {
        "title": "Clock",
        "variations": {
            "overview": {
                "title": "Square pixels and capsule sliders",
                "config": {
                    "slider_style": "capsule"
                }
            },
            "dark": {
                "title": "Dark theme, round pixels and list gallery",
                "dark": true,
                "config": {
                    "slider_style": "bar",
                    "effect_view": "list",
                    "items_per_page": 2,
                    "preview_appearance": {
                        "background": "black",
                        "pixels": "circle",
                        "spacing": "normal",
                        "shadow": false,
                        "ignoreBlack": false
                    }
                }
            },
            "soft": {
                "title": "Rounded pixels and compact text styles",
                "config": {
                    "slider_style": "slider",
                    "style_selector_style": "filled",
                    "buttons_style": "outline",
                    "preview_appearance": {
                        "background": "white",
                        "pixels": "rounded",
                        "spacing": "subtle",
                        "shadow": true,
                        "ignoreBlack": true
                    }
                }
            },
            "mobile": {
                "title": "Narrow dashboard column",
                "width": 320,
                "config": {
                    "slider_style": "capsule"
                }
            },
            "offline": {
                "title": "Local previews while the lamp is unavailable",
                "offline": true
            },
            "frame": {
                "title": "Card title, lamp status and no card background",
                "config": {
                    "title": "Living room",
                    "show_lamp_status": true,
                    "show_card_background": false
                }
            }
        },
        "editors": {
            "general": "Global Settings",
