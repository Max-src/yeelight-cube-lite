{
    "name": "yeelight-cube-docs",
    "private": true,
    "scripts": {
        "docs:screenshots": "node tests/card-docs.cjs",
        "docs:readme": "node tests/card-docs-readme.cjs",
        "docs:overviews": "node tests/card-docs-overview.cjs",
        "docs:check": "node tests/card-docs-readme.cjs --check",
        "docs:update": "npm run docs:screenshots && npm run docs:overviews && npm run docs:readme",
        "build:lit": "node scripts/build-lit.mjs",
        "check": "node scripts/check.mjs",
        "check:quick": "node scripts/check.mjs --quick",
        "lint": "ruff check . && eslint ."
    },
    "devDependencies": {
        "esbuild": "0.25.10",
        "eslint": "9.39.5",
        "globals": "16.5.0",
        "lit": "2.8.0",
        "playwright": "1.58.2",
        "pngjs": "7.0.0"
    }
}
